{
  "name": "aura-space-monorepo",
  "private": true,
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "provision:appwrite": "node appwrite/scripts/provision-appwrite.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "turbo": "^2.11.11"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.13.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
